# Optional for local development; npm run dev defaults to local server storage.
# Local server data is ignored by Git. Do not use local mode on Vercel/Netlify.
# TRAFFIC_STORAGE=local
# TRAFFIC_DATA_DIR=.local/scenarios

# Deployment: create a Supabase project, run supabase/migrations/001_traffic_lab.sql,
# and set these ONLY in the hosting provider's server environment settings.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
